# Namuna .env — nusxa oling: cp .env.example .env
# Barcha kalitlar `decouple.config` orqali `config/settings.py` da o'qiladi.

SECRET_KEY=change-me
DEBUG=False

# Vergul bilan ajratiladi.
ALLOWED_HOSTS=usta-top.simpl.uz,ustachi.uz,www.ustachi.uz
CSRF_TRUSTED_ORIGINS=https://usta-top.simpl.uz,https://ustachi.uz,https://www.ustachi.uz

# Telegramdan Usta ilovasidagi buyurtmaga o'tish uchun Android App Links.
APP_LINK_BASE_URL=https://ustachi.uz
# Play Console → App integrity → App signing key certificate → SHA-256
# Bir nechta sertifikat bo'lsa vergul bilan ajrating.
ANDROID_APP_LINK_SHA256_FINGERPRINTS=90:0F:82:A3:8D:C2:89:D7:28:3D:07:30:F1:CB:42:B7:5D:DC:EB:27:EB:AC:F0:24:E1:6E:9C:71:73:73:07:FC

# SMS (Eskiz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_TIMEOUT=10

# ──────────────────────── FCM push (Firebase) ────────────────────────
# Xizmat akkaunti kaliti (Firebase Console → Project settings → Service
# accounts → Generate new private key). Faylni serverga QO'LDA qo'ying —
# repoga tushmaydi. Bo'sh qoldirilsa `secrets/firebase-admin.json` olinadi;
# fayl bo'lmasa push jimgina o'chadi (qolgan hammasi ishlayveradi).
FIREBASE_CREDENTIALS=/home/pc2/usta_top/secrets/firebase-admin.json
FCM_ENABLED=True
# Fon oqimida yuborish (so'rov FCM javobini kutmaydi). Testlarda False.
FCM_BACKGROUND=True
# Android bildirishnoma kanali — Flutter tomonda ayni shu nom bilan yaratiladi.
FCM_ANDROID_CHANNEL=usta_top

# ─────────────────────────── WebSocket ───────────────────────────
# Channels kanal qatlami. BO'SH bo'lsa — InMemory (jarayon ichida).
#
# InMemory FAQAT BITTA worker bilan to'g'ri ishlaydi: hodisa qaysi jarayonda
# yuborilsa, o'sha jarayondagi WebSocket'largagina yetadi. Hozirgi sozlama —
# `--workers 1` (systemd drop-in: asgi.conf), shuning uchun bu bo'sh qoldirilgan.
#
# Worker sonini OSHIRSANGIZ bu MAJBURIY bo'ladi, aks holda bir worker qabul
# qilgan chat xabari boshqa worker'dagi ulanishga bormaydi:
#   sudo apt install redis-server
#   REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# ─────────────────────── Telegram ───────────────────────
# Ochiq buyurtmalar kanalga, yangi foydalanuvchilar admin guruhi topigiga
# yuboriladi. Bot kanalga post joylay olish huquqi bilan qo'shilishi kerak.
# Topik ID — topikdagi xabar havolasidagi raqam: t.me/c/<chat>/<TOPIC_ID>/<msg>.
TELEGRAM_BOT_TOKEN=
# Auth bot is separate from order notifications. Set after rotating the BotFather token.
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=ustachi_auth_bot
TELEGRAM_AUTH_WEBHOOK_SECRET=
CLIENT_APP_STORE_URL=https://play.google.com/store/apps/details?id=com.ustachi.mijoz
TELEGRAM_CHAT_ID=
TELEGRAM_ORDERS_CHANNEL_ID=@ustachi_buyurtmalar
TELEGRAM_ORDERS_CHANNEL_URL=https://t.me/ustachi_buyurtmalar
TELEGRAM_USERS_TOPIC_ID=
MASTER_APP_STORE_URL=https://play.google.com/store/apps/details?id=com.ustachi.pro
CLIENT_ANDROID_APP_LINK_SHA256_FINGERPRINTS=

# --- LOG ---
LOG_LEVEL=INFO

# --- OTP ---
# DEMO hisob: do'kon (Google Play / App Store) moderatori uchun.
# Shu raqamga kod DOIM quyidagicha bo'ladi, SMS yuborilmaydi va
# tezlik cheklovi qo'llanmaydi. Bo'sh qoldirilsa demo hisob o'chadi.
OTP_DEMO_PHONE=+998917777777
OTP_DEMO_CODE=777777
# Mijoz ilovasi tekshiruvi uchun ALOHIDA demo raqam (usta demosidan mustaqil):
OTP_DEMO_PHONE_CLIENT=+998918888888
OTP_DEMO_CODE_CLIENT=888888

# ⚠️ BO'SH bo'lmasa HAR QANDAY raqamga shu kod beriladi (ishlab chiqish
# qulayligi uchun). PRODUCTIONDA BO'SH QOLDIRING:
#   OTP_STATIC_CODE=
OTP_STATIC_CODE=111111
